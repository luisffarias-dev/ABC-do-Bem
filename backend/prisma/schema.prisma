// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================
enum Role {
  USER
  ONG
  ADMIN
}

enum ApplicationStatus {
  PENDING // Voluntário pediu para participar (Aguardando ONG)
  CONFIRMED // ONG aceitou
  REJECTED // ONG recusou ou não tem mais vaga
  COMPLETED // Evento passou e o voluntário compareceu (Gera as "Horas doadas")
  CANCELLED // Voluntário desistiu
}

// ==========================================
// TABELA: USER (Centraliza Voluntários e ONGs)
// ==========================================
model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String
  role     Role    @default(USER)
  avatar   String?

  // --- Endereço Compartilhado ---
  cep        String?
  logradouro String?
  numero     String?
  bairro     String?
  cidade     String?
  estado     String?

  // --- Conformidade Legal ---
  aceiteTermos Boolean @default(false)
  aceiteLgpd   Boolean @default(false)

  // --- CAMPOS EXCLUSIVOS: VOLUNTÁRIO (Role.USER) ---
  tipoDocumento   String?
  cpf             String?  @unique
  nascimento      String?
  telefone        String?
  bio             String?
  habilidades     String[]
  disponibilidade String[]

  // --- CAMPOS EXCLUSIVOS: ONG (Role.ONG) ---
  razaoSocial         String?
  cnpj                String?  @unique
  anoFundacao         Int?
  site                String?
  telefoneFixo        String?
  whatsapp            String?
  instagram           String?
  facebook            String?
  tiktok              String?
  causaPrincipal      String?
  servicosOferecidos  String[]
  publicoAtendido     String[]
  descricao           String?
  habilidadesBuscadas String[]
  formatoVoluntariado String?
  aceitaDoacoes       String[]

  // --- Relacionamentos ---
  opportunities Opportunity[] @relation("OngOpportunities") // Vagas criadas pela ONG
  applications  Application[] @relation("UserApplications") // Vagas nas quais o voluntário se inscreveu

  sentMessages     Message[] @relation("SentMessages") // Mensagens Enviadas
  receivedMessages Message[] @relation("ReceivedMessages") // Mensagens Recebidas

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// TABELA: OPORTUNIDADES (Eventos/Vagas criadas pelas ONGs)
// ==========================================
model Opportunity {
  id          String  @id @default(uuid())
  title       String
  description String
  banner      String?

  // Datas e Horas 
  eventDate      DateTime
  durationHours  Int
  totalVacancies Int

  // Categorias para filtro
  categories String[]

  // Localização do evento (pode ser diferente da sede da ONG)
  cep        String?
  logradouro String?
  numero     String?
  bairro     String?
  cidade     String?
  estado     String?
  latitude   Float?
  longitude  Float?

  // Relacionamento com a ONG criadora
  ongId String
  ong   User   @relation("OngOpportunities", fields: [ongId], references: [id], onDelete: Cascade)

  // Relacionamento com as inscrições
  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// TABELA: INSCRIÇÕES (A ponte Voluntário <-> Vaga)
// ==========================================
model Application {
  id String @id @default(uuid())

  // Voluntário inscrito
  userId String
  user   User   @relation("UserApplications", fields: [userId], references: [id], onDelete: Cascade)

  // Vaga desejada
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  // Status da candidatura
  status ApplicationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Garante que a mesma pessoa não se inscreva duas vezes na mesma vaga
  @@unique([userId, opportunityId])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())
  read       Boolean  @default(false)

  // Relações
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
}