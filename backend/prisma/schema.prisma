// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================
enum Role {
  USER
  ONG
  ADMIN
}

enum ApplicationStatus {
  PENDING    // Voluntário pediu para participar (Aguardando ONG)
  CONFIRMED  // ONG aceitou
  REJECTED   // ONG recusou ou não tem mais vaga
  COMPLETED  // Evento passou e o voluntário compareceu
  CANCELLED  // Voluntário desistiu
  PRESENT    // Confirmou presença no dia
  ABSENT     // Faltou no dia
  ACCEPTED   // Adicionado para suportar aprovação pelo painel (Dashboard)
}

// ==========================================
// TABELA: USER (Centraliza Voluntários e ONGs)
// ==========================================
model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String
  role     Role    @default(USER)
  avatar   String?

  // --- Endereço Compartilhado ---
  cep        String?
  logradouro String?
  numero     String?
  bairro     String?
  cidade     String?
  estado     String?

  // --- Conformidade Legal ---
  aceiteTermos Boolean @default(false)
  aceiteLgpd   Boolean @default(false)

  // --- Campos para Confirmação de Email ---
  pendingEmail           String?
  emailConfirmationToken String?

  // --- CAMPOS EXCLUSIVOS: VOLUNTÁRIO (Role.USER) ---
  tipoDocumento   String?
  cpf             String?  @unique
  nascimento      String?
  telefone        String?
  bio             String?
  habilidades     String[]
  disponibilidade String[]

  // --- CAMPOS EXCLUSIVOS: ONG (Role.ONG) ---
  razaoSocial               String?
  cnpj                      String?  @unique
  anoFundacao               Int?
  site                      String?
  telefoneFixo              String?
  whatsapp                  String?
  instagram                 String?
  facebook                  String?
  tiktok                    String?
  causaPrincipal            String?
  servicosOferecidos        String[]
  publicoAtendido           String[]
  descricao                 String?
  habilidadesBuscadas       String[]
  formatoVoluntariado       String?
  aceitaDoacoes             String[]
  necessidadesAtuais        String[]
  chavePix                  String?
  horarioRecebimentoDoacoes String?

  // --- Relacionamentos Originais ---
  opportunities    Opportunity[] @relation("OngOpportunities")
  applications     Application[] @relation("UserApplications")
  sentMessages     Message[]     @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")

  // --- Relacionamentos (Feed, Notificações e Seguidores) ---
  notifications        Notification[]
  volunteerExperiences VolunteerExperience[]
  ongPosts             OngPost[]
  followers            OngFollower[]         @relation("OngToFollower")
  following            OngFollower[]         @relation("VolunteerToOng")

  // --- Relacionamentos (Curtidas e Comentários) ---
  ongPostLikes    OngPostLike[]
  experienceLikes VolunteerExperienceLike[]
  ongPostComments OngPostComment[]

  // --- Relacionamentos (Metas, Suprimentos e Compromissos de Doação) ---
  goals    OngGoal[]      @relation("OngGoals")
  supplies OngSupply[]    @relation("OngSupplies")
  pledges  SupplyPledge[] @relation("VolunteerPledges")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// TABELA: OPORTUNIDADES (Eventos/Vagas)
// ==========================================
model Opportunity {
  id          String  @id @default(uuid())
  title       String
  description String
  banner      String?

  eventDate      DateTime
  durationHours  Int
  totalVacancies Int
  categories     String[]

  // --- Modalidade e Regras ---
  modality       String    @default("PRESENCIAL") // "PRESENCIAL", "REMOTO", "HIBRIDO"
  endDate        DateTime?
  requiredSkills String[]
  minAge         Int?
  requirements   String[]
  status         String    @default("ATIVA") // "ATIVA", "LOTADA", "CONCLUIDA", "CANCELADA"

  cep        String?
  logradouro String?
  numero     String?
  bairro     String?
  cidade     String?
  estado     String?
  latitude   Float?
  longitude  Float?

  ongId String
  ong   User   @relation("OngOpportunities", fields: [ongId], references: [id], onDelete: Cascade)

  applications Application[]
  ongPosts     OngPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// TABELA: INSCRIÇÕES (A ponte Voluntário <-> Vaga)
// ==========================================
model Application {
  id String @id @default(uuid())

  userId String
  user   User   @relation("UserApplications", fields: [userId], references: [id], onDelete: Cascade)

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  status ApplicationStatus @default(PENDING)

  // --- Suporte e Validação de Horas ---
  caronaOuSuporte  String?
  autorizouContato Boolean @default(true)
  horasValidadas   Int     @default(0)

  // --- Sistema de Carona Específico e Validação de Presença ---
  attended       Boolean @default(false)
  tipoCarona     String? @default("NENHUMA") // "NENHUMA", "PRECISA_CARONA", "OFERECE_CARONA"
  detalhesCarona String?

  // --- Feedback da ONG e Certificado ---
  feedbackOng       String?
  certificateCode   String?   @unique
  certificateIssued Boolean   @default(false)
  certificateDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, opportunityId])
}

// ==========================================
// TABELA: MENSAGENS (Chat)
// ==========================================
model Message {
  id         String  @id @default(uuid())
  content    String
  senderId   String
  receiverId String
  read       Boolean @default(false)

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  deletedForSender   Boolean @default(false)
  deletedForReceiver Boolean @default(false)

  createdAt DateTime @default(now())
}

// ==========================================
// TABELAS: NOTIFICAÇÕES E FEED SOCIAL
// ==========================================

// 1. Notificações do Sistema
model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String
  read    Boolean @default(false)

  type   String? // Ex: "NEW_MESSAGE", "CERTIFICATE_READY", "SUPPLY_NEEDED", "NEW_PLEDGE", "NEW_OPPORTUNITY_MATCH"
  linkId String? // ID do recurso relacionado para navegação no app

  createdAt DateTime @default(now())
}

// 2. Feed: Relatos do Voluntário
model VolunteerExperience {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ongName       String
  text          String
  imageUrl      String?
  formattedDate String // Ex: "Novembro/2026"

  likes VolunteerExperienceLike[]

  createdAt DateTime @default(now())
}

// 3. Feed: Postagens/Mural da ONG
model OngPost {
  id    String @id @default(uuid())
  ongId String
  ong   User   @relation(fields: [ongId], references: [id], onDelete: Cascade)

  title    String
  text     String
  imageUrl String?

  opportunityId String?
  opportunity   Opportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  likes         OngPostLike[]
  comments      OngPostComment[]

  createdAt DateTime @default(now())
}

// 4. Sistema de Seguidores (Voluntário segue ONG)
model OngFollower {
  id    String @id @default(uuid())
  ongId String
  ong   User   @relation("OngToFollower", fields: [ongId], references: [id], onDelete: Cascade)

  volunteerId String
  volunteer   User   @relation("VolunteerToOng", fields: [volunteerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([ongId, volunteerId])
}

// 5. Curtidas e Comentários (Social)
model OngPostLike {
  id     String @id @default(uuid())
  userId String
  postId String

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  post OngPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model VolunteerExperienceLike {
  id           String @id @default(uuid())
  userId       String
  experienceId String

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience VolunteerExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, experienceId])
}

model OngPostComment {
  id      String @id @default(uuid())
  postId  String
  userId  String
  content String

  post OngPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ==========================================
// TABELAS: METAS E MINI-ERP DE SUPRIMENTOS DA ONG
// ==========================================

model OngGoal {
  id    String @id @default(uuid())
  ongId String
  ong   User   @relation("OngGoals", fields: [ongId], references: [id], onDelete: Cascade)

  titulo      String
  descricao   String?
  valorAtual  Float     @default(0)
  valorMeta   Float
  unidade     String    // Ex: "cestas", "horas", "kits", "voluntários"
  prazoLimite DateTime?
  status      String    @default("EM_ANDAMENTO") // "EM_ANDAMENTO", "CONCLUIDA", "ATRASADA"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OngSupply {
  id    String @id @default(uuid())
  ongId String
  ong   User   @relation("OngSupplies", fields: [ongId], references: [id], onDelete: Cascade)

  nome                String
  unidade             String    // Ex: "kg", "unidades", "litros", "pacotes"
  quantidadeMeta      Float
  quantidadeRecebida  Float     @default(0)
  quantidadePrometida Float     @default(0)
  prazoLimite         DateTime?
  prioridade          String    @default("MEDIA") // "BAIXA", "MEDIA", "ALTA", "URGENTE"
  status              String    @default("ABERTO") // "ABERTO", "PARCIAL", "ATENDIDO", "CANCELADO"
  sincronizarPerfil   Boolean   @default(true)

  pledges SupplyPledge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupplyPledge {
  id       String    @id @default(uuid())
  supplyId String
  supply   OngSupply @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  volunteerId String?
  volunteer   User?   @relation("VolunteerPledges", fields: [volunteerId], references: [id], onDelete: SetNull)

  doadorNome        String
  doadorContato     String?
  quantidade        Float
  dataLimiteEntrega DateTime?
  status            String    @default("PROMETIDO") // "PROMETIDO", "ENTREGUE", "ATRASADO", "CANCELADO"
  observacoes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}