// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================
enum Role {
  USER
  ONG
  ADMIN
}

enum ApplicationStatus {
  PENDING // Voluntário pediu para participar (Aguardando ONG)
  CONFIRMED // ONG aceitou
  REJECTED // ONG recusou ou não tem mais vaga
  COMPLETED // Evento passou e o voluntário compareceu
  CANCELLED // Voluntário desistiu
  PRESENT // NOVO: Confirmou presença no dia
  ABSENT // NOVO: Faltou no dia
}

// ==========================================
// TABELA: USER (Centraliza Voluntários e ONGs)
// ==========================================
model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String
  role     Role    @default(USER)
  avatar   String?

  // --- Endereço Compartilhado ---
  cep        String?
  logradouro String?
  numero     String?
  bairro     String?
  cidade     String?
  estado     String?

  // --- Conformidade Legal ---
  aceiteTermos Boolean @default(false)
  aceiteLgpd   Boolean @default(false)

  // --- CAMPOS EXCLUSIVOS: VOLUNTÁRIO (Role.USER) ---
  tipoDocumento   String?
  cpf             String?  @unique
  nascimento      String?
  telefone        String?
  bio             String?
  habilidades     String[]
  disponibilidade String[]

  // --- CAMPOS EXCLUSIVOS: ONG (Role.ONG) ---
  razaoSocial         String?
  cnpj                String?  @unique
  anoFundacao         Int?
  site                String?
  telefoneFixo        String?
  whatsapp            String?
  instagram           String?
  facebook            String?
  tiktok              String?
  causaPrincipal      String?
  servicosOferecidos  String[]
  publicoAtendido     String[]
  descricao           String?
  habilidadesBuscadas String[]
  formatoVoluntariado String?
  aceitaDoacoes       String[]

  // --- Relacionamentos Originais ---
  opportunities    Opportunity[] @relation("OngOpportunities")
  applications     Application[] @relation("UserApplications")
  sentMessages     Message[]     @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")

  // --- NOVOS Relacionamentos (Feed, Notificações e Seguidores) ---
  notifications        Notification[]
  volunteerExperiences VolunteerExperience[]
  ongPosts             OngPost[]
  followers            OngFollower[]         @relation("OngToFollower")
  following            OngFollower[]         @relation("VolunteerToOng")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// TABELA: OPORTUNIDADES (Eventos/Vagas)
// ==========================================
model Opportunity {
  id          String  @id @default(uuid())
  title       String
  description String
  banner      String?

  eventDate      DateTime
  durationHours  Int
  totalVacancies Int
  categories     String[]

  cep        String?
  logradouro String?
  numero     String?
  bairro     String?
  cidade     String?
  estado     String?
  latitude   Float?
  longitude  Float?

  ongId String
  ong   User   @relation("OngOpportunities", fields: [ongId], references: [id], onDelete: Cascade)

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// TABELA: INSCRIÇÕES (A ponte Voluntário <-> Vaga)
// ==========================================
model Application {
  id String @id @default(uuid())

  userId String
  user   User   @relation("UserApplications", fields: [userId], references: [id], onDelete: Cascade)

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  status ApplicationStatus @default(PENDING)

  // --- NOVOS CAMPOS: Suporte e Validação de Horas ---
  caronaOuSuporte  String?
  autorizouContato Boolean @default(true)
  horasValidadas   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, opportunityId])
}

// ==========================================
// TABELA: MENSAGENS (Chat)
// ==========================================
model Message {
  id         String  @id @default(uuid())
  content    String
  senderId   String
  receiverId String
  read       Boolean @default(false)

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  createdAt DateTime @default(now())
}

// ==========================================
// NOVAS TABELAS (NOTIFICAÇÕES E FEED SOCIAL)
// ==========================================

// 1. Notificações do Sistema
model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String
  read    Boolean @default(false)

  type   String? // Ex: "NEW_MESSAGE", "APPLICATION_APPROVED"
  linkId String? // ID do evento ou da conversa para o app navegar ao clicar

  createdAt DateTime @default(now())
}

// 2. Feed: Relatos do Voluntário
model VolunteerExperience {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ongName       String
  text          String
  imageUrl      String?
  formattedDate String // Ex: "Novembro/2026"

  createdAt DateTime @default(now())
}

// 3. Feed: Postagens/Mural da ONG
model OngPost {
  id    String @id @default(uuid())
  ongId String
  ong   User   @relation(fields: [ongId], references: [id], onDelete: Cascade)

  title    String
  text     String
  imageUrl String?

  createdAt DateTime @default(now())
}

// 4. Sistema de Seguidores (Voluntário segue ONG)
model OngFollower {
  id    String @id @default(uuid())
  ongId String
  ong   User   @relation("OngToFollower", fields: [ongId], references: [id], onDelete: Cascade)

  volunteerId String
  volunteer   User   @relation("VolunteerToOng", fields: [volunteerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([ongId, volunteerId]) // Um voluntário só segue a mesma ONG uma vez
}
